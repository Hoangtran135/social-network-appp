PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/social-network-app

# Required in production — generate long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed frontend origins in production (e.g. https://a2t.io.vn,https://www.a2t.io.vn)
CORS_ORIGIN=

# Optional — SMTP for password-reset emails. If unset, reset links are logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SocialNet <no-reply@a2t.io.vn>

# Optional — powers the "Trợ Lý AI" chatbot account. Get a key from Google AI Studio
# (aistudio.google.com/apikey). If unset, the bot account still exists but won't reply.
GEMINI_API_KEY=
